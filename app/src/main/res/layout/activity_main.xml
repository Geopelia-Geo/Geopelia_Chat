<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen">

    <!-- 自定义背景图（可选） -->
    <ImageView
        android:id="@+id/backgroundImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <!-- 半透明遮罩，保证文字可读 -->
    <View
        android:id="@+id/backgroundScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scrim"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 顶部栏（LINE 风格：白底 + 1px 分割线） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="@color/bg_bar"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="6dp"
            android:paddingEnd="10dp">

            <!-- 返回：回到主屏幕 -->
            <TextView
                android:id="@+id/btnBack"
                android:layout_width="36dp"
                android:layout_height="44dp"
                android:text="‹"
                android:textSize="30sp"
                android:textColor="@color/text_primary"
                android:gravity="center"
                android:textStyle="bold" />

            <!-- 对方（AI）头像 -->
            <ImageView
                android:id="@+id/headerAvatar"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="AI" />

            <!-- 用户名 + 状态 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/headerName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="AI 助手"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/headerStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="在线"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- 菜单：打开设置（电话按钮已去掉） -->
            <TextView
                android:id="@+id/btnMenu"
                android:layout_width="36dp"
                android:layout_height="44dp"
                android:text="☰"
                android:textSize="22sp"
                android:textColor="@color/icon_tint"
                android:gravity="center" />
        </LinearLayout>

        <!-- 1px 分割线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <!-- 日期 -->
        <TextView
            android:id="@+id/dateLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/date_text"
            android:textSize="11sp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp" />

        <!-- 聊天区域 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="13dp"
            android:clipToPadding="false" />

        <!-- 1px 分割线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <!-- 输入区（LINE 风格） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@color/bg_bar"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="6dp"
            android:paddingEnd="9dp">

            <!-- 圆角输入框（多行输入，回车换行 → 发送时自动拆条） -->
            <EditText
                android:id="@+id/inputMessage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:minHeight="42dp"
                android:hint="输入消息"
                android:background="@drawable/bg_input_round"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:gravity="center_vertical"
                android:inputType="textMultiLine"
                android:maxLines="4"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/input_hint" />

            <!-- 表情：矢量图标，点击弹出黄脸 emoji 面板 -->
            <ImageButton
                android:id="@+id/btnToolSmile"
                android:layout_width="40dp"
                android:layout_height="44dp"
                android:background="@android:color/transparent"
                android:contentDescription="表情"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_smile"
                android:tint="@color/icon_tint" />

            <!-- 发送：↑ 圆形 -->
            <TextView
                android:id="@+id/btnSend"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:text="↑"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:background="@drawable/bg_send_circle" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
