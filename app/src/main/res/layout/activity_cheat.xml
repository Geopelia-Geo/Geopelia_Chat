<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_screen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:background="@color/bg_bar"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="6dp"
        android:paddingEnd="10dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="44dp"
            android:text="‹"
            android:textSize="30sp"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="作弊菜单"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_card">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="好感度"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/curLoveLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="当前：0 点 · LV.1"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/etLovePoints"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:hint="输入好感度数值"
                        android:inputType="number"
                        android:background="@drawable/bg_input_round"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/input_hint" />

                    <TextView
                        android:id="@+id/btnSetLove"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginStart="10dp"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:text="设置"
                        android:textSize="14sp"
                        android:textColor="#FFFFFF"
                        android:gravity="center"
                        android:background="@drawable/bg_sign_btn_pink" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnResetLove"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="10dp"
                    android:text="好感度归零"
                    android:textSize="14sp"
                    android:textColor="#FF6B81"
                    android:gravity="center"
                    android:background="@drawable/bg_mood_btn" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_card">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="心情状态"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnMoodHappy"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:text="开心"
                        android:textSize="13sp"
                        android:gravity="center"
                        android:textColor="@color/text_primary"
                        android:background="@drawable/bg_mood_btn" />

                    <TextView
                        android:id="@+id/btnMoodNormal"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="平静"
                        android:textSize="13sp"
                        android:gravity="center"
                        android:textColor="@color/text_primary"
                        android:background="@drawable/bg_mood_btn" />

                    <TextView
                        android:id="@+id/btnMoodSad"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="低落"
                        android:textSize="13sp"
                        android:gravity="center"
                        android:textColor="@color/text_primary"
                        android:background="@drawable/bg_mood_btn" />

                    <TextView
                        android:id="@+id/btnMoodShy"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="害羞"
                        android:textSize="13sp"
                        android:gravity="center"
                        android:textColor="@color/text_primary"
                        android:background="@drawable/bg_mood_btn" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnMoodTired"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:text="疲惫"
                        android:textSize="13sp"
                        android:gravity="center"
                        android:textColor="@color/text_primary"
                        android:background="@drawable/bg_mood_btn" />

                    <TextView
                        android:id="@+id/btnMoodAngry"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="生气"
                        android:textSize="13sp"
                        android:gravity="center"
                        android:textColor="@color/text_primary"
                        android:background="@drawable/bg_mood_btn" />

                    <TextView
                        android:id="@+id/btnMoodJealous"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="吃醋"
                        android:textSize="13sp"
                        android:gravity="center"
                        android:textColor="@color/text_primary"
                        android:background="@drawable/bg_mood_btn" />

                    <TextView
                        android:id="@+id/btnMoodUpset"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="委屈"
                        android:textSize="13sp"
                        android:gravity="center"
                        android:textColor="@color/text_primary"
                        android:background="@drawable/bg_mood_btn" />
                </LinearLayout>

                <TextView
                    android:id="@+id/moodHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="当前心情：平静"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
